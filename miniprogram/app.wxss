page{--ink:#1f3a33;--muted:#7d8d84;--faint:#a9b5ad;--green:#1a6851;--deep:#12493a;--pale:#edf4ed;--line:#e6eae3;--paper:#f5f6f1;--amber:#b18a32;--amber-pale:#fbf3df;--red:#b94e49;--red-pale:#f8e9e8;background:var(--paper);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Noto Sans CJK SC","Microsoft YaHei",sans-serif;font-size:28rpx;line-height:1.5}
.page{padding:24rpx 32rpx 48rpx;box-sizing:border-box}
.card{background:#fff;border-radius:28rpx;padding:32rpx;margin-bottom:24rpx;box-shadow:0 2rpx 4rpx rgba(31,58,51,.04),0 12rpx 32rpx rgba(31,58,51,.05)}
.card-heading{display:flex;align-items:center;gap:16rpx;margin-bottom:8rpx}
.step-number{font-size:20rpx;color:var(--green);background:var(--pale);border-radius:10rpx;padding:4rpx 12rpx;font-weight:600;font-variant-numeric:tabular-nums}
.h2{font-size:32rpx;font-weight:600;flex:1}
.tag{font-size:20rpx;color:var(--green);background:var(--pale);border-radius:999rpx;padding:4rpx 18rpx}
.eyebrow{display:block;font-size:20rpx;letter-spacing:4rpx;color:var(--muted);font-weight:600}
.muted{color:var(--muted);line-height:1.7}
.hint{display:block;color:var(--muted);font-size:22rpx;line-height:1.6;margin-top:10rpx}
.label{display:block;font-size:26rpx;font-weight:600;margin:32rpx 0 14rpx}
.label-note{color:var(--muted);font-weight:400;font-size:22rpx;margin-left:12rpx}
.input,.picker{border:2rpx solid var(--line);border-radius:18rpx;background:#fafbf8;height:88rpx;padding:0 24rpx;box-sizing:border-box;display:flex;align-items:center;color:var(--ink);font-size:28rpx;font-family:inherit}
.picker::after{content:"";width:12rpx;height:12rpx;border-right:3rpx solid var(--muted);border-bottom:3rpx solid var(--muted);transform:rotate(45deg) translateY(-4rpx);margin-left:auto}
.placeholder{color:var(--faint);font-family:inherit}
.row-between{display:flex;justify-content:space-between;align-items:center}
.text-button{color:var(--green);font-size:24rpx;padding:8rpx 0}
.error{display:block;color:var(--red);font-size:24rpx;line-height:1.6;margin-top:12rpx}
.error:empty{display:none}
button.primary,button.secondary{border-radius:20rpx;font-size:30rpx;font-weight:600;height:96rpx;line-height:96rpx;padding:0 32rpx;margin:0;width:100%}
button.primary{background:var(--green);color:#fff;border:none;box-shadow:0 8rpx 20rpx rgba(26,104,81,.22)}
button.primary.button-hover{background:var(--deep)}
button.primary[disabled]{background:#9dbcae!important;color:#fff!important;box-shadow:none}
button.secondary{background:#fff;color:var(--ink);border:2rpx solid var(--line)}
button.secondary.button-hover{background:var(--pale)}
button.primary::after,button.secondary::after{border:none}
.hidden{display:none!important}
