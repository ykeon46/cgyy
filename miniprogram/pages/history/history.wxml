<view class="page">
  <view class="header">
    <text class="eyebrow">BOOKING HISTORY</text>
    <view class="row-between"><text class="title">预约记录</text><text class="count">{{jobs.length}} 条</text></view>
    <text class="muted">当前账号最近30条记录及未完成任务</text>
  </view>

  <view wx:if="{{!jobs.length}}" class="card empty">
    <view class="empty-icon"><view class="empty-ring"></view></view>
    <text class="empty-title">还没有预约任务</text>
    <text class="hint">先去选择一个喜欢的场次吧。</text>
  </view>

  <view class="card list" wx:else>
    <view class="row" wx:for="{{jobs}}" wx:key="id" bindtap="open" data-id="{{item.id}}" hover-class="row-hover">
      <view class="bar {{item.tone}}"></view>
      <view class="info">
        <view class="row-title"><text>{{item.title}}</text><text wx:if="{{item.daily}}" class="mini-tag">每日</text></view>
        <text class="meta">{{item.subtitle}}</text>
        <text wx:if="{{item.tradeNo}}" class="meta mono">订单 {{item.tradeNo}}</text>
      </view>
      <text class="status {{item.tone}}">{{item.label}}</text>
    </view>
  </view>
  <text class="error">{{error}}</text>
</view>
