.header{padding:16rpx 8rpx 28rpx}
.title{font-size:48rpx;font-weight:700;margin-top:6rpx}
.count{font-size:24rpx;color:var(--green);background:var(--pale);border-radius:999rpx;padding:4rpx 18rpx}
.header .muted{font-size:24rpx}
.empty{display:flex;flex-direction:column;align-items:center;padding:72rpx 32rpx}
.empty-icon{width:120rpx;height:120rpx;border-radius:50%;background:var(--pale);display:flex;align-items:center;justify-content:center;margin-bottom:24rpx}
.empty-ring{width:48rpx;height:48rpx;border-radius:50%;border:6rpx solid var(--green);opacity:.5}
.empty-title{font-weight:600;font-size:30rpx}
.list{padding:8rpx 0}
.row{display:flex;align-items:center;gap:20rpx;padding:26rpx 28rpx 26rpx 0;border-top:2rpx solid #f0f2ed}
.row:first-child{border-top:none}
.row-hover{background:#fafbf8}
.bar{width:8rpx;align-self:stretch;border-radius:0 8rpx 8rpx 0;background:#dfe5dc}
.bar.good{background:var(--green)}
.bar.live{background:var(--amber)}
.bar.bad{background:var(--red)}
.info{flex:1;min-width:0}
.row-title{display:flex;align-items:center;gap:12rpx;font-weight:600;font-size:28rpx}
.mini-tag{font-size:18rpx;font-weight:500;color:var(--green);background:var(--pale);border-radius:8rpx;padding:2rpx 10rpx}
.meta{display:block;color:var(--muted);font-size:22rpx;margin-top:6rpx;word-break:break-all}
.mono{font-family:Menlo,monospace;font-size:20rpx}
.status{font-size:22rpx;border-radius:999rpx;padding:6rpx 18rpx;background:#f1f3ef;color:var(--muted);white-space:nowrap}
.status.live{background:var(--amber-pale);color:var(--amber)}
.status.good{background:var(--pale);color:var(--green)}
.status.bad{background:var(--red-pale);color:var(--red)}
