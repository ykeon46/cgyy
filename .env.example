# 复制为 .env 后在本机填写，再执行 source .env；脚本不会自动读取该文件。
export BUAA_SSO_USER=''
export BUAA_SSO_PASSWORD=''
# 单笔付款上限；15.00 仅适用于此前的15元测试场次。
export CGYY_MAX_PAY_AMOUNT='15.00'
# 微信小程序访问密钥（至少16位），生成：python -c "import secrets;print(secrets.token_urlsafe(24))"
export CGYY_MINIPROGRAM_KEY=''
# 手机推送地址（可选）：Bark、Server酱、ntfy 或任意接收 JSON POST 的地址，见 README“手机推送”。
export CGYY_NOTIFY_URL=''
# 设为 0 则每次登录和预约都单独启动浏览器，不使用常驻浏览器。
export CGYY_PERSISTENT_BROWSER='1'
# 设为 0 则空闲时不预先打开场馆预约页。
export CGYY_WARM_TABS='1'
